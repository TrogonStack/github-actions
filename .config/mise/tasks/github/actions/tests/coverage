#!/usr/bin/env bash
#MISE description="Test coverage publication and shared action execution"
set -euo pipefail

coverage_test_env=$(mktemp -d "$PWD/.coverage-test.XXXXXX")
trap 'rm -rf "$coverage_test_env"' EXIT
python3 -m venv "$coverage_test_env"
"$coverage_test_env/bin/python" -m pip install --disable-pip-version-check 'pycobertura==3.0.0'
PATH="$coverage_test_env/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 "$coverage_test_env/bin/python" -m unittest discover -s tests/coverage-report -v
